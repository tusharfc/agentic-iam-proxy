# Licensing (leave POLAR_LICENSE_KEY empty for the Community edition)
POLAR_API_URL=https://api.polar.sh
POLAR_ORGANIZATION_ID=
POLAR_LICENSE_KEY=
# JSON map of Polar benefit IDs to tiers
POLAR_BENEFIT_TIERS={"<pro-benefit-id>": "pro", "<enterprise-benefit-id>": "enterprise"}
LICENSE_ENFORCEMENT=true
LICENSE_CACHE_TTL_SECONDS=3600
LICENSE_GRACE_SECONDS=259200
UPGRADE_URL=https://polar.sh/your-org

# Billing webhooks (Polar -> POST /api/v1/webhooks/polar)
POLAR_WEBHOOK_SECRET=
# JSON map of Polar product IDs to tiers
POLAR_PRODUCT_TIERS={"<pro-product-id>": "pro", "<enterprise-product-id>": "enterprise"}

# Supabase (service-role key bypasses RLS: backend only, never ship to clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proxy
PROXY_TIMEOUT_SECONDS=60
# true only for local development: lets agents reach localhost and private networks
PROXY_ALLOW_PRIVATE_TARGETS=false

# Human-in-the-loop approvals
REDIS_URL=redis://localhost:6379/0
HITL_TIMEOUT_SECONDS=300
# Slack app > Incoming Webhooks (approval requests are posted here; enable Interactivity with
# Request URL https://<your-host>/api/v1/callbacks/slack). Empty: request IDs are only logged.
SLACK_WEBHOOK_URL=
# Slack app > Basic Information > Signing Secret
SLACK_SIGNING_SECRET=
# true only for local development (curl testing without a Slack app)
SLACK_ALLOW_UNSIGNED_CALLBACKS=false

# Downstream API key vault (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every stored key unreadable; changing it requires re-encrypting tenant_api_keys.
VAULT_ENCRYPTION_KEY=
