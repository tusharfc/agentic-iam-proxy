# Billing webhooks (Polar -> POST /api/v1/webhooks/polar)
POLAR_WEBHOOK_SECRET=
# JSON map of Polar product IDs to tiers
POLAR_PRODUCT_TIERS={"<pro-product-id>": "pro", "<enterprise-product-id>": "enterprise"}

# Postgres 14+. Docker Compose sets this itself for its bundled database (and creates the tables),
# so only set it when running outside Compose, e.g. against the bundled database from your host:
#   DATABASE_URL=postgresql://iamproxy:iamproxy@127.0.0.1:54320/iamproxy
DATABASE_URL=
# Password of the bundled Postgres container (default: iamproxy). Change it for anything beyond local use.
POSTGRES_PASSWORD=

# Proxy
PROXY_TIMEOUT_SECONDS=60
# true only for local development: lets agents reach localhost and private networks
PROXY_ALLOW_PRIVATE_TARGETS=false

# Human-in-the-loop approvals
REDIS_URL=redis://localhost:6379/0
HITL_TIMEOUT_SECONDS=300
# Slack app > Incoming Webhooks (approval requests are posted here; enable Interactivity with
# Request URL https://<your-host>/api/v1/callbacks/slack). Empty: request IDs are only logged.
SLACK_WEBHOOK_URL=
# Slack app > Basic Information > Signing Secret
SLACK_SIGNING_SECRET=
# true only for local development (curl testing without a Slack app)
SLACK_ALLOW_UNSIGNED_CALLBACKS=false

# Headless approvals (your own dashboard instead of, or alongside, Slack).
# Signed JSON is POSTed here; approve/deny via POST /api/v1/callbacks/approve|deny (needs X-Management-Token).
# Must be https (http allowed only for localhost). Generate a secret with: openssl rand -hex 32
CUSTOM_WEBHOOK_URL=
CUSTOM_WEBHOOK_SECRET=

# Downstream API key vault (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every stored key unreadable; changing it requires re-encrypting tenant_api_keys.
VAULT_ENCRYPTION_KEY=
